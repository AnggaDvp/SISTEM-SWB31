# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit file .env.local / .env ke GitHub.

# Dari Turso: `turso db show nss-swb31 --url`
TURSO_DATABASE_URL=libsql://nama-database-anda.turso.io

# Dari Turso: `turso db tokens create nss-swb31`
TURSO_AUTH_TOKEN=

# Akun admin utama
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=ganti-dengan-password-panjang-dan-unik

# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
SESSION_SECRET=
